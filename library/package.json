{
  "name": "@ssingh465/recipe-ui",
  "version": "1.1.0",
  "description": "Stencil web component library for Recipe Finder & Meal Planner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssingh465/recipe-finder-meal-planner.git",
    "directory": "library"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "types": "./dist/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/components/**"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "lint": "eslint src",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "eslint": "^10.9.0",
    "playwright": "^1.52.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.0"
  }
}
