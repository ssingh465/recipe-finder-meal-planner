{
	"extends": "stylelint-config-standard",
	"overrides": [
		{
			"files": ["**/*.svelte"],
			"customSyntax": "postcss-html"
		},
		{
			"files": ["src/lib/styles/tokens.css"],
			"rules": {
				"color-no-hex": null
			}
		}
	],
	"rules": {
		"color-no-hex": true,
		"selector-pseudo-class-no-unknown": [
			true,
			{
				"ignorePseudoClasses": ["global"]
			}
		]
	}
}
